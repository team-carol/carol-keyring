{
  // Worker(Cloudflare 런타임) 타입 검사. 런타임 타입은 pnpm cf-typegen 으로 만든 worker-configuration.d.ts 에 있다.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": [],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["worker", "worker-configuration.d.ts"]
}
